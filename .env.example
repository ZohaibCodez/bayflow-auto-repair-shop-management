# ---------------------------------------------------------------------------
# BayFlow environment variables
# Copy to .env and fill in real values. NEVER commit real values.
#   cp .env.example .env
# (Prisma and Next.js both read .env.)
# ---------------------------------------------------------------------------

# --- App ---
# Public base URL of the app — used for absolute links. On Vercel, set to the live URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL 15+; Neon recommended) ---
# Pooled connection string — used by the app at runtime (Neon: the "-pooler" host)
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/bayflow?sslmode=require"
# Direct (non-pooled) connection — used by Prisma Migrate and the seed script only
# (for a local Postgres, use the same value as DATABASE_URL)
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/bayflow?sslmode=require"

# --- Auth (Auth.js v5) ---
# Secret used to sign session JWTs. Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
# How long a sign-in lasts, in days (default 7)
AUTH_SESSION_DAYS=7
# Only needed behind a proxy / custom domain if Auth.js can't infer the host
# AUTH_URL=https://your-bayflow-domain.example

# --- E2E tests (optional) ---
# Run the Playwright suite against a deployment instead of localhost
# E2E_BASE_URL=https://your-bayflow-domain.example

# --- Bonus: in-app calling (not used yet — leave blank) ---
CALL_PROVIDER_API_KEY=
CALL_PROVIDER_API_SECRET=

# --- Bonus: AI Front Desk (not used yet — leave blank) ---
# LLM with tool calling (e.g. Anthropic Claude)
ANTHROPIC_API_KEY=
# Speech-to-text / text-to-speech or realtime voice provider
VOICE_PROVIDER_API_KEY=

# --- Optional: email notifications (not used yet — in-app notifications are built in) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
