# ---------------------------------------------------------------------------
# BayFlow environment variables
# Copy to .env.local (dev) and set real values. NEVER commit real values.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
# Public base URL of the app (used by Auth.js + absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
# Pooled connection — used by the app at runtime
DATABASE_URL="postgres://USER:PASSWORD@POOLED_HOST:5432/bayflow?sslmode=require"
# Direct connection — used by Prisma Migrate / seed only
DIRECT_URL="postgres://USER:PASSWORD@DIRECT_HOST:5432/bayflow?sslmode=require"

# --- Auth (Auth.js v5) ---
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=change-me-to-a-long-random-string
# Session lifetime in days
AUTH_SESSION_DAYS=7

# --- Bonus: in-app calling (leave blank if unused) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# --- Bonus: AI Front Desk (leave blank if unused) ---
ANTHROPIC_API_KEY=
# Optional speech provider (STT/TTS or realtime voice)
VOICE_PROVIDER_API_KEY=

# --- Optional: email notifications ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
